<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RealTime.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SignalR server is part of the ASP.NET Core shared framework: no package needed for hubs. -->
    <!-- JWT bearer authentication (also pulls in Microsoft.IdentityModel.JsonWebTokens used by TokenService). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <!-- Advanced (scale-out). Uncomment together with .AddStackExchangeRedis(...) in Program.cs -->
    <!-- <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.11" /> -->
    <!-- Advanced (binary protocol). Uncomment together with .AddMessagePackProtocol() in Program.cs -->
    <!-- <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.11" /> -->
  </ItemGroup>

</Project>
